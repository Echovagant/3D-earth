{
  "name": "earth-project",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "check": "npm run lint:check && npm run test:unit && npm run build",
    "geo:update": "node scripts/update-geo.mjs",
    "geo:check": "node scripts/update-geo.mjs --check",
    "world:update": "node scripts/update-world.mjs",
    "world:check": "node scripts/update-world.mjs --check",
    "tw:update": "node scripts/update-tw.mjs",
    "tw:check": "node scripts/update-tw.mjs --check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "format": "prettier --write src/"
  },
  "overrides": {
    "editorconfig": "^3.0.2",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.6",
    "nanoid": "^6.0.2",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "rollup": "^4.64.12",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.2.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "earcut": "^2.2.2",
    "three": "^0.180.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "3.6.2",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.7"
  }
}
